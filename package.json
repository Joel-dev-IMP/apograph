{
  "name": "apograph",
  "displayName": "Apograph",
  "description": "Autocompletion of terms and sentences from your lecture slides for faster note-taking in Markdown or Typst",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.144.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "apograph.helloWorld",
        "title": "Hello World"
      }
    ],
    "languages": [
      {
        "id": "markdown",
        "configuration": "./languages/all.config.json"
      },
      {
        "id": "typst",
        "configuration": "./languages/all.config.json"
      }
    ],
    "snippets": [
      {
        "language": "typst",
        "path": "./snippets/typst.json"
      }
    ]
  },
  "scripts": {
    "build": "vsce package --out build/",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "format": "prettier --write ./",
    "lint": "eslint src",
    "test": "vscode-test",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.144.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vsce": "^2.15.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
